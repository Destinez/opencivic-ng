# Postgres started by docker compose. Leave unset to use the embedded
# database (pglite) for local UI work.
DATABASE_URL=postgres://opencivic:opencivic@localhost:5432/opencivic

# Comma-separated browser origins allowed to call the API directly.
WEB_ORIGINS=http://localhost:3000

# Set true behind HTTPS.
COOKIE_SECURE=false

UPLOAD_DIR=./.data/uploads
PORT=4000

# Seed sample geography, guidance, demo accounts, and demo observations on boot.
SEED_ON_BOOT=true

# Optional overrides for the three demo accounts. Defaults are public.
# SEED_OBSERVER_EMAIL=ada.okonkwo@example.com
# SEED_OBSERVER_PASSWORD=observer-demo-pass
# SEED_REVIEWER_EMAIL=chidi.bello@example.com
# SEED_REVIEWER_PASSWORD=reviewer-demo-pass
# SEED_ADMIN_EMAIL=amina.yusuf@example.com
# SEED_ADMIN_PASSWORD=admin-demo-pass

# Web process. Browser calls are proxied through /backend.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
